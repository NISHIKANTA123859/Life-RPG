# ================================================================
# Life RPG Backend — Environment Configuration Example
# ================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env to version control.
# ================================================================

# ── Project metadata ──────────────────────────────────────────────
PROJECT_NAME="Life RPG API"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# ── Database ──────────────────────────────────────────────────────
# Primary (PostgreSQL). The server will fall back to SQLite when
# this connection cannot be reached.
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/life_rpg"

# Fallback (SQLite – great for local development without Postgres)
SQLITE_FALLBACK_URL="sqlite:///./life_rpg.db"

# ── JWT / Security ────────────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY="replace-this-with-a-long-random-secret-key"
ALGORITHM="HS256"
# Token lifetime in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
